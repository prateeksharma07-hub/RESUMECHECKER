{
  "name": "careerlens-ai",
  "version": "1.0.0",
  "description": "CareerLens AI - Professional AI Resume Analyzer & Career Advisor",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "start": "npm run dev",
    "server": "npm --prefix server start",
    "client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "keywords": [
    "ai",
    "resume-analyzer",
    "career-advisor",
    "gemini",
    "ats",
    "react",
    "express"
  ],
  "author": "CareerLens AI Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
